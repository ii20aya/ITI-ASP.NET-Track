<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – QuickSort Lab</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="top-nav">
        <a class="nav-brand" href="/">⚡ QuickSort Lab</a>
        <div class="nav-links">
            <a href="/">Sort</a>
            <a href="https://github.com" target="_blank">GitHub</a>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>Built with GitHub Copilot · C# .NET 8 · VS 2022 — Lab Assignment</p>
    </footer>

    <script src="~/js/app.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
