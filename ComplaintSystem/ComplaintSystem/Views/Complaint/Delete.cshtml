@model ComplaintSystem.Models.Complaint

@{
    ViewData["Title"] = "Delete Complaint";
}

<div class="row justify-content-center">
    <div class="col-lg-6">

        <div class="card border-danger shadow-sm" style="border-radius:16px;overflow:hidden">
            <div class="card-header bg-danger text-white fw-bold fs-5">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion
            </div>
            <div class="card-body p-4">
                <p class="text-muted mb-3">
                    You are about to permanently delete the following complaint.
                    <strong>This action cannot be undone.</strong>
                    All replies attached to this complaint will also be removed.
                </p>

                <dl class="row mb-0">
                    <dt class="col-sm-3">Title</dt>
                    <dd class="col-sm-9">@Model.Title</dd>

                    <dt class="col-sm-3">Category</dt>
                    <dd class="col-sm-9">@Model.Category?.Name</dd>

                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">
                        <complaint-status status="@Model.Status"></complaint-status>
                    </dd>

                    <dt class="col-sm-3">Submitted</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")</dd>

                    <dt class="col-sm-3">Replies</dt>
                    <dd class="col-sm-9">@Model.Replies.Count reply/replies will be deleted</dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex gap-2">
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger" id="deleteBtn">
                        <i class="bi bi-trash-fill me-1"></i>Yes, Delete
                    </button>
                </form>
                <a asp-action="Details" asp-route-id="@Model.Id"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </a>
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    // jQuery: add spinner to delete button on click to prevent double-submit
    $(function () {
        $('form').on('submit', function () {
            $('#deleteBtn')
                .prop('disabled', true)
                .html('<span class="spinner-border spinner-border-sm me-1"></span>Deleting…');
        });
    });
</script>
}
