@model ComplaintCreateVM

@{
    ViewData["Title"] = "New Complaint";
}

<div class="create-wrap">
    <div class="page-header">
        <div class="d-flex align-items-center gap-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h3 class="mb-0">Submit a Complaint</h3>
                <p class="text-muted mb-0" style="font-size:.82rem">All fields marked * are required</p>
            </div>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 rounded-3"></div>

    <div class="form-panel">
        <form asp-action="Create" method="post" novalidate id="createForm">
            @Html.AntiForgeryToken()

            <div class="field-group">
                <label asp-for="Title" class="form-label">
                    Title <span class="text-danger">*</span>
                </label>
                <input asp-for="Title" class="form-control" id="titleInput"
                       placeholder="Brief summary of the issue" autocomplete="off" />
                <span asp-validation-for="Title" class="text-danger" style="font-size:.8rem"></span>
            </div>

            <div class="field-group">
                <label asp-for="Description" class="form-label">
                    Description <span class="text-danger">*</span>
                </label>
                <textarea asp-for="Description" class="form-control" rows="5" id="descInput"
                          placeholder="Describe the issue in detail..."></textarea>
                <span asp-validation-for="Description" class="text-danger" style="font-size:.8rem"></span>
                <div class="char-bar mt-2">
                    <div class="char-bar-fill" id="charFill"></div>
                </div>
                <div class="d-flex justify-content-between mt-1">
                    <small class="text-muted">Be as specific as possible</small>
                    <small class="text-muted" id="charCount">0 / 2000</small>
                </div>
            </div>

            <div class="field-group">
                <label class="form-label d-block mb-2">
                    Category <span class="text-danger">*</span>
                </label>
                @if (Model.Categories != null && Model.Categories.Any())
                {
                    <div class="cat-grid">
                        @foreach (var cat in Model.Categories)
                        {
                            string ico = "bi bi-folder";
                            string cls = "";

                            if (cat.Text == "Billing")   { ico = "bi bi-receipt";  cls = "ci-billing"; }
                            else if (cat.Text == "Delivery") { ico = "bi bi-truck";  cls = "ci-delivery"; }
                            else if (cat.Text == "Product")  { ico = "bi bi-box-seam"; cls = "ci-product"; }
                            else if (cat.Text == "Service")  { ico = "bi bi-headset"; cls = "ci-service"; }
                            else if (cat.Text == "Technical"){ ico = "bi bi-tools";  cls = "ci-technical"; }

                            <div>
                                <input type="radio" name="CategoryId"
                                       id="cat-@cat.Value"
                                       value="@cat.Value"
                                       class="cat-radio"
                                       @(Model.CategoryId.ToString() == cat.Value ? "checked" : "") />
                                <label class="cat-label" for="cat-@cat.Value">
                                    <div class="cat-icon @cls">
                                        <i class="@ico"></i>
                                    </div>
                                    @cat.Text
                                </label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="CategoryId" class="text-danger" style="font-size:.8rem"></span>
                }
                else
                {
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">— Select a category —</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger" style="font-size:.8rem"></span>
                }
            </div>

            <div class="d-flex gap-2 pt-1">
                <button type="submit" class="btn btn-primary px-4" id="submitBtn">
                    <i class="bi bi-send me-1"></i>Submit Complaint
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $('#descInput').on('input', function () {
                var len = $(this).val().length;
                var pct = Math.min(100, len / 2000 * 100);
                $('#charCount').text(len + ' / 2000');
                if (len > 1900) { $('#charCount').addClass('text-danger'); } else { $('#charCount').removeClass('text-danger'); }
                var color = len > 1900 ? '#DC2626' : len > 1500 ? '#D97706' : 'var(--caramel)';
                $('#charFill').css({ width: pct + '%', background: color });
            });
            $('#createForm').on('submit', function () {
                var btn = document.getElementById('submitBtn');
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Submitting...';
                btn.disabled = true;
            });
        });
    </script>
}
