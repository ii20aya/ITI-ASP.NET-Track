@model ComplaintDetailsVM
@using ComplaintSystem.Models.Enum

@{
    ViewData["Title"] = "Complaint Details";
    bool isAdmin = User.IsInRole("Admin");

    string badgeCls;
    string badgeLbl;

    if (Model.Status == ComplaintStatus.Pending)       { badgeCls = "badge-pending";    badgeLbl = "Pending"; }
    else if (Model.Status == ComplaintStatus.InProgress) { badgeCls = "badge-inprogress"; badgeLbl = "In Progress"; }
    else if (Model.Status == ComplaintStatus.Resolved)   { badgeCls = "badge-resolved";   badgeLbl = "Resolved"; }
    else if (Model.Status == ComplaintStatus.Rejected)   { badgeCls = "badge-rejected";   badgeLbl = "Rejected"; }
    else                                                { badgeCls = "badge-pending";    badgeLbl = "Unknown"; }
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <span class="text-muted" style="font-size:.82rem">
        Complaints / <span class="text-navy fw-800">#@Model.Id</span>
    </span>
</div>

<div class="details-grid">

    <div>
        <div class="detail-panel">
            <div class="panel-top">
                <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap">
                    <div class="d-flex align-items-center gap-3">
                        @if (!string.IsNullOrEmpty(Model.CategoryImageUrl))
                        {
                            <img src="@Model.CategoryImageUrl" alt="@Model.CategoryName"
                                 style="width:44px;height:44px;border-radius:10px;object-fit:cover;border:1px solid var(--border)" />
                        }
                        else
                        {
                            <div style="width:44px;height:44px;border-radius:10px;
                                        background:linear-gradient(135deg,var(--navy),var(--navy-light));
                                        display:flex;align-items:center;justify-content:center;
                                        color:#fff;font-weight:700;font-size:1rem">
                                @Model.CategoryName.FirstOrDefault()
                            </div>
                        }
                        <div>
                            <div style="font-size:.75rem;color:var(--text-muted);font-weight:600">@Model.CategoryName</div>
                            <span class="badge-status @badgeCls">@badgeLbl</span>
                        </div>
                    </div>
                    <div style="font-size:.75rem;color:var(--text-muted)">#@Model.Id</div>
                </div>
            </div>

            <div class="panel-body">
                <h4 class="fw-800 mb-3 text-navy">@Model.Title</h4>
                <div class="meta-row">
                    <div class="meta-item">
                        <i class="bi bi-calendar3"></i>
                        Submitted @Model.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                    </div>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="meta-item">
                            <i class="bi bi-pencil"></i>
                            Updated @Model.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm")
                        </div>
                    }
                </div>
                <div class="desc-text">@Model.Description</div>
            </div>

            <div class="panel-footer">
                @if (!isAdmin)
                {
                    @* User: can edit their own complaint from here *@
                    <a asp-action="Edit" asp-route-id="@Model.Id"
                       class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <a asp-action="Chat" asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="bi bi-chat-dots me-1"></i>Live Chat
                    </a>
                }
                else
                {
                    <span class="text-muted" style="font-size:.8rem">
                        <i class="bi bi-info-circle me-1"></i>Admin: view only — manage in Admin Panel
                    </span>
                }
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-auto">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
            </div>
        </div>
    </div>

    <div style="display:flex;flex-direction:column;gap:1rem">

        <div class="detail-panel">
            <div class="panel-top" style="font-weight:700;font-size:.875rem;color:var(--navy)">
                <i class="bi bi-chat-dots-fill me-2 text-caramel"></i>
                Replies <span class="text-muted" style="font-weight:400;margin-left:4px">(@Model.Replies.Count)</span>
            </div>
            <div class="panel-body replies-box" id="repliesBox">
                @if (!Model.Replies.Any())
                {
                    <div class="text-center py-3 text-muted" style="font-size:.85rem;font-style:italic">
                        No replies yet.
                    </div>
                }
                else
                {
                    @foreach (var r in Model.Replies)
                    {
                        <div class="reply-bubble">
                            <div class="reply-text">@r.Content</div>
                            <div class="reply-ts">
                                <i class="bi bi-clock me-1"></i>@r.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="reply-form-wrap">
            <div class="form-header">
                <i class="bi bi-reply-fill me-2 text-caramel"></i>Add a Reply
            </div>
            <div class="form-body">
                <form asp-action="AddReply" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="NewReply.ComplaintId" type="hidden" />
                    <div class="mb-2">
                        <textarea asp-for="NewReply.Content" class="form-control" rows="3"
                                  id="replyTa" placeholder="Write your reply here..."
                                  maxlength="1000"></textarea>
                        <span asp-validation-for="NewReply.Content"
                              class="text-danger" style="font-size:.78rem"></span>
                        <div class="d-flex justify-content-end mt-1">
                            <small class="text-muted" id="replyCnt">0 / 1000</small>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-success w-100 btn-sm">
                        <i class="bi bi-send me-1"></i>Post Reply
                    </button>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var box = document.getElementById('repliesBox');
            if (box) { box.scrollTop = box.scrollHeight; }
            $('#replyTa').on('input', function () {
                var l = $(this).val().length;
                $('#replyCnt').text(l + ' / 1000');
                if (l > 920) { $('#replyCnt').addClass('text-danger'); }
                else { $('#replyCnt').removeClass('text-danger'); }
            });
        });
    </script>
}
