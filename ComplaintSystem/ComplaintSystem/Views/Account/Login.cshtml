@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <div class="auth-header">
            <div class="auth-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h2>Welcome Back</h2>
            <p>Sign in to your Complaint System account</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @Html.ValidationSummary(true, "", new { @class = "mb-0" })
            </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="form-group-styled">
                <label asp-for="Email">
                    <i class="bi bi-envelope me-1"></i> Email Address
                </label>
                <input asp-for="Email"
                       class="form-control-styled"
                       placeholder="you@example.com"
                       autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group-styled">
                <label asp-for="Password">
                    <i class="bi bi-lock me-1"></i> Password
                </label>
                <div class="input-with-toggle">
                    <input asp-for="Password"
                           id="passwordInput"
                           class="form-control-styled"
                           placeholder="••••••••"
                           autocomplete="current-password" />
                    <button type="button" class="toggle-pw" onclick="togglePassword()">
                        <i class="bi bi-eye" id="eyeIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="form-check-styled">
                <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                <label for="rememberMe">Remember me for 7 days</label>
            </div>

            <button type="submit" class="btn-auth">
                <span>Sign In</span>
                <i class="bi bi-arrow-right-circle-fill"></i>
            </button>
        </form>

        <div class="auth-footer">
            Don't have an account?
            <a asp-controller="Account" asp-action="Register">Create one free</a>
        </div>
    </div>

    <div class="bg-papers">
        <div class="bg-paper bp1"></div>
        <div class="bg-paper bp2"></div>
        <div class="bg-paper bp3"></div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    function togglePassword() {
        var inp = document.getElementById('passwordInput');
        var ico = document.getElementById('eyeIcon');
        if (inp.type === 'password') {
            inp.type = 'text';
            ico.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            inp.type = 'password';
            ico.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }
</script>
}
