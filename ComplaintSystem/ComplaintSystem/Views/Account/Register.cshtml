@model ComplaintSystem.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-wrapper">
    <div class="auth-card auth-card-wide">

        <div class="auth-header">
            <div class="auth-icon">
                <i class="bi bi-person-plus-fill"></i>
            </div>
            <h2>Create Account</h2>
            <p>Join to start submitting and tracking your complaints</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="auth-alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                @Html.ValidationSummary(true, "", new { @class = "mb-0" })
            </div>
        }

        <form asp-action="Register" asp-controller="Account" method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <div class="form-group-styled">
                <label asp-for="FullName">
                    <i class="bi bi-person me-1"></i> Full Name
                </label>
                <input asp-for="FullName"
                       class="form-control-styled"
                       placeholder="Ahmed Mohamed"
                       autocomplete="name" />
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>

            <div class="form-group-styled">
                <label asp-for="Email">
                    <i class="bi bi-envelope me-1"></i> Email Address
                </label>
                <input asp-for="Email"
                       class="form-control-styled"
                       placeholder="you@example.com"
                       autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group-styled">
                <label asp-for="Password">
                    <i class="bi bi-lock me-1"></i> Password
                </label>
                <div class="input-with-toggle">
                    <input asp-for="Password"
                           id="passwordInput"
                           class="form-control-styled"
                           placeholder="Min. 6 characters"
                           autocomplete="new-password" />
                    <button type="button" class="toggle-pw"
                            onclick="togglePassword('passwordInput','eyeIcon1')">
                        <i class="bi bi-eye" id="eyeIcon1"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="form-group-styled">
                <label asp-for="ConfirmPassword">
                    <i class="bi bi-lock-fill me-1"></i> Confirm Password
                </label>
                <div class="input-with-toggle">
                    <input asp-for="ConfirmPassword"
                           id="confirmInput"
                           class="form-control-styled"
                           placeholder="Repeat your password"
                           autocomplete="new-password" />
                    <button type="button" class="toggle-pw"
                            onclick="togglePassword('confirmInput','eyeIcon2')">
                        <i class="bi bi-eye" id="eyeIcon2"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <div class="strength-wrap">
                <div class="strength-bar">
                    <div class="strength-fill" id="strengthFill"></div>
                </div>
                <span class="strength-label" id="strengthLabel">Password strength</span>
            </div>

            <button type="submit" class="btn-auth">
                <span>Create Account</span>
                <i class="bi bi-person-check-fill"></i>
            </button>
        </form>

        <div class="auth-footer">
            Already have an account?
            <a asp-controller="Account" asp-action="Login">Sign in here</a>
        </div>
    </div>

    <div class="bg-papers">
        <div class="bg-paper bp1"></div>
        <div class="bg-paper bp2"></div>
        <div class="bg-paper bp3"></div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    function togglePassword(inputId, iconId) {
        var inp = document.getElementById(inputId);
        var ico = document.getElementById(iconId);
        if (inp.type === 'password') {
            inp.type = 'text';
            ico.classList.replace('bi-eye', 'bi-eye-slash');
        } else {
            inp.type = 'password';
            ico.classList.replace('bi-eye-slash', 'bi-eye');
        }
    }

    document.getElementById('passwordInput').addEventListener('input', function () {
        var val   = this.value;
        var score = 0;
        if (val.length >= 6)          score++;
        if (val.length >= 10)         score++;
        if (/[A-Z]/.test(val))        score++;
        if (/[0-9]/.test(val))        score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;

        var colors = ['#dc3545','#fd7e14','#ffc107','#20c997','#198754'];
        var labels = ['Very weak','Weak','Fair','Strong','Very strong'];
        var pcts   = [20, 40, 60, 80, 100];

        var fill  = document.getElementById('strengthFill');
        var label = document.getElementById('strengthLabel');

        fill.style.width      = score > 0 ? pcts[score - 1] + '%' : '0%';
        fill.style.background = score > 0 ? colors[score - 1] : 'transparent';
        label.textContent     = score > 0 ? labels[score - 1] : 'Password strength';
    });
</script>
}
