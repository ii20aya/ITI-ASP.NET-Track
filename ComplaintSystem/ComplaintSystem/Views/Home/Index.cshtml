@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* ═══════════════════════════════════════════════════
   SECTION 1 — Hero (light bg, pen writes, paper sits)
   Paper will fly out on scroll to Section 2
═══════════════════════════════════════════════════ *@
<div id="heroSection" class="hero-section">

    <div class="hero-inner">

        @* LEFT — Paper + Pen animation *@
        <div class="hero-left">
            <div class="paper-stage">

                @* Paper — will animate on scroll *@
                <div class="journey-paper" id="journeyPaper">
                    <div class="paper-inner">
                        <div class="paper-header-line"></div>
                        <div class="paper-stamp">
                            <span>COMPLAINT</span>
                            <span class="stamp-id">#0042</span>
                        </div>
                        <div class="paper-lines">
                            <div class="pline" style="width:88%;animation-delay:.3s"></div>
                            <div class="pline" style="width:74%;animation-delay:.7s"></div>
                            <div class="pline" style="width:82%;animation-delay:1.1s"></div>
                            <div class="pline" style="width:60%;animation-delay:1.5s"></div>
                            <div class="pline" style="width:70%;animation-delay:1.9s"></div>
                        </div>
                        <div class="paper-sig"></div>
                    </div>
                </div>

                @* Pen only — bottom-left of paper, angled like the red arrow *@
                <svg id="handPenSvg" class="hand-pen-svg"
                     viewBox="0 0 340 380" fill="none"
                     xmlns="http://www.w3.org/2000/svg">
                    @*
                        The red arrow in the image points to bottom-left of the paper.
                        We translate the pen group to (88,168) and rotate -142deg
                        so the nib points upper-right (writing direction).
                    *@
                    <g id="penGroup" transform="translate(88,180) rotate(300)">
                        <rect x="-5.5" y="0"   width="11" height="86" rx="3.5" fill="#1c1c3a"/>
                        <rect x="-5.5" y="0"   width="11" height="9"  rx="3"   fill="#C8960E"/>
                        <rect x="-5.5" y="79"  width="11" height="7"  rx="1"   fill="#C8960E"/>
                        <rect x="5"    y="3"   width="2.5" height="58" rx="1.2" fill="#B8884A"/>
                        <circle cx="6.2" cy="60" r="2.2" fill="#B8884A"/>
                        <rect x="-5.5" y="85"  width="11" height="22" rx="2"   fill="#252545"/>
                        <polygon points="-5.5,107 5.5,107 0,128" fill="#ADADAD"/>
                        <line x1="0" y1="107" x2="0" y2="128" stroke="#777" stroke-width="0.8"/>
                        <circle cx="0" cy="128" r="2" fill="#444"/>
                    </g>
                </svg>

            </div>
        </div>

        @* RIGHT — Hero text *@
        <div class="hero-right">
            <div class="hero-badge">
              
                Complaint System
            </div>
            <h1 class="hero-title">
                Every Voice<br />
                <em>Deserves</em> to<br />
                be <em>Heard</em>
            </h1>
           
            <div class="hero-actions">
                <a asp-controller="Complaint" asp-action="Create" class="hero-btn-primary">
                    <i class="bi bi-pencil-square"></i> File a Complaint
                </a>
                <a asp-controller="Complaint" asp-action="Index" class="hero-btn-ghost">
                    Browse All <i class="bi bi-arrow-right"></i>
                </a>
            </div>
           
               
           
        </div>

    </div>
</div>

@* ═══════════════════════════════════════════════════
   SECTION 2 — Folder (paper flies here on scroll)
   Folder is at the bottom-left, same position as
   the red rectangle in Image 2
═══════════════════════════════════════════════════ *@
<div id="folderSection" class="folder-section">

    <div class="folder-layout">

        @* LEFT — Folder animation zone *@
        <div class="folder-zone">
            <div class="folder-wrap" id="folderWrap">
                <div class="folder-tab"></div>
                <div class="folder-lid" id="folderLid"></div>
                <div class="folder-body">
                    <div class="folder-lines">
                        <div class="f-line" style="width:72%"></div>
                        <div class="f-line" style="width:52%"></div>
                        <div class="f-line" style="width:62%"></div>
                    </div>
                    <div class="folder-label">FILED</div>
                </div>
            </div>
            <div class="folder-caption">
                <span>Your complaint, securely filed</span>
            </div>
        </div>

        @* RIGHT — Steps *@
        <div class="steps-zone">
            <div class="sec-eyebrow">HOW IT WORKS</div>
            <h2 class="sec-title">From Complaint to Resolution</h2>
            <p class="sec-sub">Three simple steps. Full visibility at every stage.</p>

            <div class="steps-list">
                <div class="step-item">
                    <div class="step-num">01</div>
                    <div class="step-ico"><i class="bi bi-pencil-square"></i></div>
                    <div>
                        <h5>File Your Complaint</h5>
                        <p>Describe your issue clearly. Choose a category and submit in under 2 minutes.</p>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num">02</div>
                    <div class="step-ico"><i class="bi bi-gear-wide-connected"></i></div>
                    <div>
                        <h5>We Review &amp; Assign</h5>
                        <p>Our admin team categorises and routes your complaint to the right department immediately.</p>
                    </div>
                </div>
                <div class="step-item">
                    <div class="step-num">03</div>
                    <div class="step-ico"><i class="bi bi-chat-dots-fill"></i></div>
                    <div>
                        <h5>Live Chat &amp; Resolution</h5>
                        <p>Chat in real-time, receive status updates, and see your issue through to full resolution.</p>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@* ═══════════════════════════════════════════════════
   SECTION 3 — CTA
═══════════════════════════════════════════════════ *@
<section class="cta-section">
    <div class="cta-wrap">
        <div class="cta-deco">
            <div class="cta-paper cp1"></div>
            <div class="cta-paper cp2"></div>
        </div>
        <div class="cta-body">
            <h2>Ready to be heard?</h2>
            <p>Join users who resolved their issues with full transparency and speed.</p>
            <div class="cta-actions">
                <a asp-controller="Account" asp-action="Register" class="hero-btn-primary">
                    <i class="bi bi-person-plus-fill"></i> Get Started Free
                </a>
                <a asp-controller="Account" asp-action="Login" class="hero-btn-ghost-dark">
                    Sign In <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
    (function () {
        var paper     = document.getElementById('journeyPaper');
        var handSvg   = document.getElementById('handPenSvg');
        var folderSec = document.getElementById('folderSection');
        var folderLid = document.getElementById('folderLid');
        var folderWrap= document.getElementById('folderWrap');

        // Paper starts in hero, absolutely positioned
        // On scroll it tracks toward folderWrap

        function ease(t) { return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t; }

        function getProgress() {
            var heroBottom = document.getElementById('heroSection').getBoundingClientRect().bottom;
            var winH = window.innerHeight;
            // progress 0 = hero fully visible, 1 = hero scrolled past
            var raw = 1 - (heroBottom / winH);
            return Math.max(0, Math.min(1, raw));
        }

        function tick() {
            var p  = getProgress();
            var et = ease(p);

            // Pen fades out as we scroll away
            handSvg.style.opacity = String(Math.max(0, 1 - p * 3));

            if (p <= 0) {
                // Reset paper to starting position in hero
                paper.style.position  = 'absolute';
                paper.style.left      = '50%';
                paper.style.top       = '44%';
                paper.style.transform = 'translate(-50%, -50%) rotate(-2deg)';
                paper.style.opacity   = '1';
                paper.style.zIndex    = '20';
                handSvg.style.opacity = '1';

                folderLid.style.transform = 'rotateX(0deg)';
                return;
            }

            if (p < 1) {
                // Paper flies: fixed position tracks from hero to folder
                var startX = 38;   // vw from left (hero left col center)
                var startY = 42;   // vh from top

                // folder target — bottom of viewport, left side
                var folderRect = folderWrap.getBoundingClientRect();
                var targetX    = folderRect.left + folderRect.width  / 2;
                var targetY    = folderRect.top  + folderRect.height / 2;

                var curX = startX * window.innerWidth  / 100 + et * (targetX - startX * window.innerWidth  / 100);
                var curY = startY * window.innerHeight / 100 + et * (targetY - startY * window.innerHeight / 100);

                var scale   = 1 - et * 0.45;
                var rotate  = -2 + et * 18;
                var opacity = p > 0.82 ? Math.max(0, 1 - (p - 0.82) / 0.18) : 1;

                paper.style.position  = 'fixed';
                paper.style.left      = curX + 'px';
                paper.style.top       = curY + 'px';
                paper.style.transform = 'translate(-50%,-50%) rotate(' + rotate + 'deg) scale(' + scale + ')';
                paper.style.opacity   = String(opacity);
                paper.style.zIndex    = '900';

                // Folder lid — opens when paper nears (p > 0.5), closes when paper inside (p > 0.8)
                if (p < 0.5) {
                    folderLid.style.transform = 'rotateX(0deg)';
                } else if (p < 0.78) {
                    var lo = (p - 0.5) / 0.28;
                    folderLid.style.transform = 'rotateX(' + (lo * -55) + 'deg)';
                } else {
                    var lc = (p - 0.78) / 0.22;
                    folderLid.style.transform = 'rotateX(' + (-55 + Math.min(1, lc) * 55) + 'deg)';
                }
            } else {
                // Paper fully inside folder — hide it
                paper.style.opacity = '0';
                folderLid.style.transform = 'rotateX(0deg)';
            }
        }

        // When scrolling back up, paper comes back out
        function tickReverse() {
            var p = getProgress();
            if (p <= 0) {
                // Reset completely
                paper.style.position  = 'absolute';
                paper.style.left      = '50%';
                paper.style.top       = '44%';
                paper.style.transform = 'translate(-50%,-50%) rotate(-2deg)';
                paper.style.opacity   = '1';
                paper.style.zIndex    = '20';
                folderLid.style.transform = 'rotateX(0deg)';
                handSvg.style.opacity = '1';
            }
        }

        window.addEventListener('scroll', function () {
            tick();
        }, { passive: true });

        tick();
    })();
    </script>
}
